# O entrypoint da imagem nginx troca ${API_URL} pelo valor da variavel de
# ambiente ao subir o container: a URL do Gateway muda sem rebuild.
server {
    listen 80;
    root /usr/share/nginx/html;

    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 "window.API_URL = '${API_URL}';\n";
    }

    location /assets/ {
        expires 7d;
    }

    location / {
        add_header Cache-Control "no-store";
        try_files $uri /index.html;
    }
}
