# O entrypoint da imagem nginx troca ${PORT} e ${API_URL} pelos valores das
# variaveis de ambiente ao subir o container: a porta e a URL do Gateway mudam
# sem rebuild. ($uri nao e variavel de ambiente e fica como esta.)
server {
    listen ${PORT};
    server_tokens off;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 "window.API_URL = '${API_URL}';\n";
    }

    # Fotos dos pratos (frontend/public/pratos/<CODIGO>.jpg). Foto que nao
    # existe responde 404 (e a tela mostra as iniciais do prato no lugar),
    # em vez de cair no index.html do fallback abaixo.
    location /pratos/ {
        expires 1d;
        try_files $uri =404;
    }

    # Arquivos do Vite tem hash no nome: podem ficar em cache por muito tempo.
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        add_header Cache-Control "no-store";
        try_files $uri /index.html;
    }
}
