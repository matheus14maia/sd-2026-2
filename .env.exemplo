# Configuracao do docker compose no seu computador. Copie para .env e ajuste:
#   Windows:      copy .env.exemplo .env
#   Linux/macOS:  cp .env.exemplo .env
# O .env nao vai para o repositorio (tem senhas). Linhas que comecam com # sao
# comentarios: o Docker ignora. Depois de mudar o .env: docker compose up -d

# ===========================================================================
# Obrigatorio
# ===========================================================================

# Senha do usuario "professor" (papel cozinha), criado pelo migrador. Use 6 ou
# mais caracteres, sem o caractere $. Vazia, o usuario da cozinha nao e criado.
DEMO_LOGIN=professor
DEMO_SENHA=

# ===========================================================================
# Ja configurado (so mude se precisar)
# ===========================================================================

# Partes do sistema que o compose sobe: banco, microsservicos, Gateway e frontend.
COMPOSE_PROFILES=banco-local,servicos,gateway,frontend

# Banco PostgreSQL em container (profile banco-local).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=delivery
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Porta do frontend no seu computador (troque se a 80 estiver ocupada, ex.: 3000).
FRONTEND_PORTA=80

# Endereco do Gateway que o navegador chama. 127.0.0.1 e nao localhost: no
# Windows o localhost pode ir para o IPv6 (::1), caminho que o Docker Desktop
# as vezes nao encaminha (a pagina fica carregando ou da ERR_CONNECTION_RESET).
API_URL=http://127.0.0.1:8000

# Segredo que assina os tokens JWT. Vazio: o Gateway sorteia um a cada subida
# (e todo mundo precisa entrar de novo). Para fixar, gere um com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SEGREDO=

# ===========================================================================
# Opcional: tire o # da linha para usar
# ===========================================================================

# Tolerancia a falhas (estes sao os padroes; ver docs/07-resiliencia.md).
# GRPC_TIMEOUT=5
# GRPC_PRAZO_TOTAL=12
# RETRY_TENTATIVAS=3
# DISJUNTOR_FALHAS=3
# DISJUNTOR_ABERTO_SEGUNDOS=15

# Injecao de falha para a demonstracao. Depois de mudar, rode
# `docker compose up -d catalogo` (ou o servico que mudou).
#   *_FALHA_PERCENTUAL  0 a 100: % das chamadas que respondem UNAVAILABLE
#   *_FALHA_ATRASO_MS   atraso em cada chamada (6000 passa do timeout de 5 s)
# CATALOGO_FALHA_PERCENTUAL=50
# CATALOGO_FALHA_ATRASO_MS=6000
# USUARIOS_FALHA_PERCENTUAL=0
# PEDIDOS_FALHA_PERCENTUAL=0

# Rastreamento das requisicoes entre os servicos (no Google Cloud vai para o
# Cloud Trace; aqui, para o Jaeger). Para ver no seu computador: troque o
# COMPOSE_PROFILES acima por banco-local,servicos,gateway,frontend,rastreamento,
# tire o # da linha abaixo, rode `docker compose up -d` e abra
# http://127.0.0.1:16686 (ver docs/08-rastreamento.md).
# RASTREAMENTO=otlp
