# Copie para .env e ajuste. O .env nao e versionado (tem senha e segredo).
# Cada maquina tem o seu .env: o COMPOSE_PROFILES escolhe o que ela sobe.

# ---------------------------------------------------------------------------
# Maquina local (tudo junto, banco em container): pode usar os valores abaixo.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=banco-local,servicos,gateway,frontend
DB_HOST=postgres
DB_PORT=5432
DB_NAME=delivery
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
# Usuario com papel cozinha, criado pelo migrador (troque a senha).
DEMO_LOGIN=professor
DEMO_SENHA=troque-esta-senha
# Porta do frontend na maquina local (no GCP e a 80).
FRONTEND_PORTA=80
API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# GCP - VM servidor-delivery (microsservicos + migrador, banco no Cloud SQL)
# ---------------------------------------------------------------------------
# COMPOSE_PROFILES=servicos
# Abre as portas gRPC para a VM do Gateway (o firewall restringe a origem).
# GRPC_BIND=0.0.0.0
# DB_HOST=<IP publico do Cloud SQL>
# DB_PORT=5432
# DB_NAME=delivery
# DB_USER=postgres
# DB_PASSWORD=<senha do Cloud SQL>
# DB_SSLMODE=require
# Gerada pelo scripts/gcp/preparar_vm.sh na primeira vez (openssl rand).
# DEMO_LOGIN=professor
# DEMO_SENHA=<senha da cozinha>

# ---------------------------------------------------------------------------
# GCP - VM delivery-gateway
# ---------------------------------------------------------------------------
# COMPOSE_PROFILES=gateway
# USUARIOS_HOST=servidor-delivery.us-central1-a.c.<projeto>.internal
# CATALOGO_HOST=servidor-delivery.us-central1-a.c.<projeto>.internal
# PEDIDOS_HOST=servidor-delivery.us-central1-a.c.<projeto>.internal
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# JWT_SEGREDO=<segredo>
# JWT_EXPIRACAO_MINUTOS=60
# CORS_ORIGENS=http://<IP do frontend>

# ---------------------------------------------------------------------------
# GCP - VM delivery-frontend
# ---------------------------------------------------------------------------
# COMPOSE_PROFILES=frontend
# API_URL=http://<IP do gateway>:8000
