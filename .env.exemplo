# Copie para .env e ajuste. O .env nao e versionado (tem a senha do banco).
#
# Local (docker compose --profile banco-local): pode usar os valores abaixo.
# GCP (Cloud SQL): DB_HOST = IP publico da instancia, DB_SSLMODE=require e a
# senha definida no Cloud SQL.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=delivery
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
